-/// 设计取舍:液态玻璃(`.glassEffect`)在 26 上对行而言视觉与毛玻璃无异，
-/// 却把行绑进 `GlassEffectContainer` 的几何合并逻辑，是展开闪烁的诱因之一。
-/// 故行级统一降为 `NSVisualEffectView` 毛玻璃，液态玻璃仅保留在底部按钮
-/// (见 `compatibleButtonStyle`)。
+/// 历史:行级液态玻璃曾在 v0.9.0 前被整体降级为毛玻璃。当时的闪烁根因后来查明是
+/// 「容器合并距离(spacing: 8) > 行间距(6)」——所有行永远处于可融合状态,展开动画
+/// 逐帧触发融合边界重算;叠加旧 `MenuBarExtra(.window)` 整窗重绘,表现为整面板闪烁。
+/// 现宿主已换成自建 NSPanel(resize 不 rebuild 视图树),容器 spacing 也已降到行距
+/// 以下,故重新引入液态玻璃,由调用方按场景选择风格。
+enum CompatibleGlassStyle {
+    /// `NSVisualEffectView` 毛玻璃(全版本同一实现)。
+    case frosted
+    /// macOS 26+ 原生液态玻璃,静态表面(设置卡片等);15 回退毛玻璃。
+    case liquid
+    /// macOS 26+ 原生液态玻璃 + `.interactive()`,用于可点击表面(面板行);15 回退毛玻璃。
+    case liquidInteractive
+}
+
+// MARK: - Compatible Glass Effect Modifier
+
+/// 跨版本玻璃效果。macOS 26+ 按 `style` 渲染原生液态玻璃或毛玻璃,
+/// macOS 15 一律回退 `NSVisualEffectView` 毛玻璃。
 ///
-/// 关键:`blendingMode` 必须用 `.withinWindow`，不能用 `.behindWindow`。
-/// `.behindWindow` 采样窗口背后的桌面——`MenuBarExtra(.window)` 展开时会 resize
-/// 宿主窗口，每一帧都要重新向 WindowServer 请求背景合成，导致整个面板(含顶部
-/// SYSTEM·LIVE)闪烁、像被重新加载。`.withinWindow` 只混合窗口内内容，resize
-/// 不再触发桌面重采样，从根上消除闪烁。
+/// 15 回退层关键:`blendingMode` 必须用 `.withinWindow`，不能用 `.behindWindow`。
+/// `.behindWindow` 采样窗口背后的桌面——面板展开时逐帧 resize，每一帧都要重新向
+/// WindowServer 请求背景合成，导致整个面板(含顶部 SYSTEM·LIVE)闪烁、像被重新
+/// 加载。`.withinWindow` 只混合窗口内内容，resize 不再触发桌面重采样。
 struct CompatibleGlassEffect: ViewModifier {
     var tint: Color
     var cornerRadius: CGFloat
+    var style: CompatibleGlassStyle = .frosted
 
     func body(content: Content) -> some View {
         let shape = RoundedRectangle(cornerRadius: cornerRadius, style: .continuous)
-        content
-            .background {
-                shape
-                    .fill(tint)
-                    .background {
-                        VisualEffectView(material: .menu, blendingMode: .withinWindow)
-                            .clipShape(shape)
-                    }
-            }
+        if #available(macOS 26, *), style != .frosted {
+            content
+                .glassEffect(liquidGlass, in: shape)
+        } else {
+            content
+                .background {
+                    shape
+                        .fill(tint)
+                        .background {
+                            VisualEffectView(material: .menu, blendingMode: .withinWindow)
+                                .clipShape(shape)
+                        }
+                }
+        }
+    }
+
+    /// 液态玻璃配置:tint 复用行级配色体系压住亮度(裸 `.regular` 深色模式偏亮偏透),
+    /// 可点击表面追加 `.interactive()` 获得指针悬停/按压反馈。
+    @available(macOS 26, *)
+    private var liquidGlass: Glass {
+        var glass = Glass.regular
+        if tint != .clear {
+            glass = glass.tint(tint)
+        }
+        if style == .liquidInteractive {
+            glass = glass.interactive()
+        }
+        return glass
     }
 }
 
