    },
    "metric.current": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前"
          }
        }
      }
    },
    "metric.average": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均"
          }
        }
      }
    },
    "metric.peak": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "峰值"
          }
        }
      }
    },
    "dialogue.calm.busy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我在盯着这些数字，今天机器有点忙。"
          }
        }
      }
    },
    "dialogue.calm.quiet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在很安静，我可以趴在菜单栏晒太阳。"
          }
        }
      }
    },
    "dialogue.cpu": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在搞什么，我感觉我在飞速运转。"
          }
        }
      }
    },
    "dialogue.gpu": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面那边有点烫，我的尾巴都在冒电光。"
          }
        }
      }
    },
    "dialogue.memory": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的脑袋要被塞满了，先关两个东西吧。"
          }
        }
      }
    },
    "dialogue.storage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的肚子快塞不下了，嗝。"
          }
        }
      }
    },
    "dialogue.network": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网线在狂奔，我的胡须都被风吹歪了。"
          }
        }
      }
    },
    "dialogue.battery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我好饿，需要充电，不然要趴下了。"
          }
        }
      }
    }
  }
}
