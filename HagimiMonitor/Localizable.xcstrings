{
  "version": "1.0",
  "sourceLanguage": "zh-Hans",
  "strings": {
    "about.diagnostics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断日志"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログ"
          }
        }
      }
    },
    "about.export-logs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出日志"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Logs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログを書き出す"
          }
        }
      }
    },
    "about.export-logs-done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Finder 中显示诊断包"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics package revealed in Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断パッケージを Finder に表示しました"
          }
        }
      }
    },
    "about.export-logs-failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出失败，请稍后重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export failed. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しに失敗しました。後でもう一度お試しください。"
          }
        }
      }
    },
    "about.exporting-logs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导出..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporting..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し中..."
          }
        }
      }
    },
    "diagnostics.readme.description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个诊断包用于帮助定位 HagimiMonitor 的异常退出、采样失败或设置问题。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This diagnostics package helps investigate HagimiMonitor unexpected exits, sampling failures, or settings issues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この診断パッケージは、HagimiMonitor の予期しない終了、サンプリング失敗、設定の問題の調査に役立ちます。"
          }
        }
      }
    },
    "diagnostics.readme.feedback": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈问题时，可以把这个压缩包附加到 GitHub Issue。如果 macOS 弹出了崩溃报告，也建议一并附上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When reporting an issue, attach this package to a GitHub Issue. If macOS showed a crash report, please include it too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を報告する際は、このパッケージを GitHub Issue に添付してください。macOS のクラッシュレポートが表示された場合は、それも一緒に添付してください。"
          }
        }
      }
    },
    "diagnostics.readme.privacy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私提示：日志可能包含设备状态、错误信息和系统日志片段。上传前你可以先解压检查内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy note: logs may include device state, error messages, and system log snippets. You can unzip and inspect the contents before uploading."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーに関する注意：ログにはデバイスの状態、エラー情報、システムログの一部が含まれる場合があります。アップロード前に解凍して内容を確認できます。"
          }
        }
      }
    },
    "diagnostics.readme.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HagimiMonitor 诊断日志"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HagimiMonitor Diagnostics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HagimiMonitor 診断ログ"
          }
        }
      }
    },
    "diagnostics.unified-log-unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导出 macOS 统一日志，诊断包仍包含应用本地日志。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS unified logs could not be exported. The diagnostics package still includes local app logs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 統合ログを書き出せませんでした。診断パッケージにはアプリのローカルログが含まれています。"
          }
        }
      }
    },
