    "health.tips.button" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health Score Explained"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评分说明"
          }
        }
      }
    },
    "health.tips.cpu" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower CPU utilization is healthier; near full below 70%, drops sharply above 90%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 利用率越低越健康；70% 以下接近满分，超过 90% 急剧下降。"
          }
        }
      }
    },
    "health.tips.disk" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No penalty while free space is sufficient; only drops when free space falls below 15%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘空间充足时不扣分，仅当剩余空间低于 15% 才开始下降。"
          }
        }
      }
    },
    "health.tips.gpu" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher GPU utilization is less healthy, computed linearly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU 利用率越高越不健康，线性计算。"
          }
        }
      }
    },
    "health.tips.intro" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The health score is based on historical statistics for the selected range (not real-time load). It is a weighted average of 7 dimensions, with an extra cap under sustained thermal throttling."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康评分基于所选时间范围的历史统计（非实时负载），由 7 个维度加权平均得出；持续热节流时额外限制分数。"
          }
        }
      }
    },
    "health.tips.memory" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher memory usage is less healthy, computed linearly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内存占用越高越不健康，线性计算。"
          }
        }
      }
    },
    "health.tips.pressure" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System memory pressure level (normal/warning/critical), tracked separately from memory usage and a better signal of memory strain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统内存压力等级（正常/警告/严重），与内存占用分开计算，更能反映内存吃紧程度。"
          }
        }
      }
    },
    "health.tips.swap" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap usage relative to physical memory — the higher the ratio, the less healthy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap 使用量相对物理内存的占比，占比越高越不健康。"
          }
        }
      }
    },
    "health.tips.thermal" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the average thermal state across the window reaches Hot or above, the score is capped to reflect the impact of thermal throttling."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当整段窗口的平均热状态达到「过热」及以上时，评分会被限制，以反映热节流对体验的影响。"
          }
        }
      }
    },
    "health.tips.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
